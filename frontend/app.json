{
  "expo": {
    "name": "Stash",
    "slug": "stash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stash",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Import screenshots into Stash",
        "NSCameraUsageDescription": "Capture content to stash",
        "NSLocationWhenInUseUsageDescription": "Resurface nearby saves"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1e1e1e"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e1e1e"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stash needs photos to save your screenshots.",
          "cameraPermission": "Stash needs the camera to capture content."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stash uses location to resurface nearby saves."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
